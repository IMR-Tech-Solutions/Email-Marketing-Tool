# ---------------------------------------------------------------------------
# Copy this file to .env and adjust if needed.
# Frontend environment. No API keys live here - the Gemini key belongs in
# Backend/.env. Anything prefixed VITE_ is bundled into the JS and is PUBLIC.
# ---------------------------------------------------------------------------

# Where the Vite dev server forwards /api requests. Change this if you run the
# FastAPI backend on a different host or port.
BACKEND_URL="http://127.0.0.1:8000"

# Absolute backend URL for the browser to call directly.
# Leave EMPTY for local development - the proxy above handles it, and relative
# /api paths avoid CORS entirely. Only set this for deployments where the app
# is served without that proxy in front of it.
VITE_API_URL=""
