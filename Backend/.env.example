# ---------------------------------------------------------------------------
# Copy this file to .env and fill it in. .env is gitignored.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Required. Create the role and database first:
#   psql -U postgres -c "CREATE ROLE salesos LOGIN PASSWORD 'your-password';"
#   psql -U postgres -c "CREATE DATABASE salesos OWNER salesos;"
# Tables are created automatically on startup.
DATABASE_URL="postgresql://salesos:your-password@127.0.0.1:5432/salesos"

# --- Claude ---------------------------------------------------------------
# Required. Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"

# Model tiering: route by task, not by habit.
# Large -> discovery, research, personalization. Quality shows up in replies.
# Small -> enrichment and classification. Cheap, structured, high volume.
# Rates for these ids live in app/pricing.py; an unlisted id is charged at
# Opus-tier rates rather than zero, so cost never silently reads as free.
CLAUDE_MODEL_LARGE="claude-opus-5"
CLAUDE_MODEL_SMALL="claude-haiku-4-5"

# --- Finding email addresses ----------------------------------------------
# Optional. The discovery agent is deliberately given no email field - a model
# with no contact database can only guess, and a guessed address either bounces
# (which burns your sending domain) or reaches a real stranger.
#
# With a key, "Find email" looks the person up in Hunter's database and returns
# their confidence score. Without one it falls back to pattern guesses checked
# against the recipient's mail server, which is weaker but costs nothing.
# Free tier (25 lookups/month): https://hunter.io/api-keys
HUNTER_API_KEY=""

# --- Dashboard login ------------------------------------------------------
# Seeds the FIRST account only, on an empty users table. After that the
# database is the source of truth. Passwords are stored bcrypt-hashed.
# To add an account or reset a password:
#   python scripts/manage_user.py set <username> <password>
DASHBOARD_USERNAME="admin"
DASHBOARD_PASSWORD=""

# Signs the login tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Left blank, one is generated per process and every restart signs users out.
SESSION_SECRET=""

# How long a login lasts, in hours.
SESSION_HOURS=12

# --- Everything else ------------------------------------------------------
# Comma-separated origins allowed to call this API (the Vite dev server).
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# How many outreach drafts to generate at the same time.
MAX_CONCURRENT_OUTREACH=4

# Fake latency for the simulated CRM push, in seconds.
CRM_SYNC_DELAY_SECONDS=0.8

# --- Freshness / refresh policy -------------------------------------------
# A record is re-verified when its freshness has decayed AND something
# depends on it. Days per ICP band.
HIGH_ICP_THRESHOLD=75
REFRESH_DAYS_HIGH_ICP_ACTIVE=30
REFRESH_DAYS_HIGH_ICP_DORMANT=90
REFRESH_DAYS_MID_ICP=180
